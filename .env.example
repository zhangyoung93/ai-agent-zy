# ============================================================
# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# 命令：copy .env.example .env
# ============================================================

# DeepSeek API Key（必填）
# 获取：https://platform.deepseek.com → API Keys → 创建
DEEPSEEK_API_KEY=sk-在这里填你的key

# DeepSeek 接口地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型：
#   deepseek-chat   轻量快速，直接给答案（日常/工具调用首选）
#   deepseek-v4-pro 推理模型，更强，会先"思考"再回答
DEEPSEEK_MODEL=deepseek-chat

# 运行环境：development | staging | production
APP_ENV=development

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
